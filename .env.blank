# Is debug mode on?
DEBUG=True

# The Django secret key
SECRET_KEY=dinosecretkey

# The Django allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# The Django log level
LOG_LEVEL=info

# The database engine
DATABASE_ENGINE=postgresql

# The database name
DATABASE_NAME=dinodb

# The database user
DATABASE_USER=dinouser

# The database password
DATABASE_PASSWORD=dinopassword

# The database host
DATABASE_HOST=db

# The database port
DATABASE_PORT=5432
